#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * GastroFlow Migration Runner
 *
 * Uso:
 *   php bin/migrate
 *   php bin/migrate --trust-current-hashes
 *
 * Executa todos os arquivos .sql em common/migrations/ que ainda
 * não foram aplicados ao banco de dados.
 *
 * Antes de aplicar qualquer migração pendente, recusa continuar se o conteúdo
 * atual de uma migração já aplicada não bater com o hash registrado na
 * primeira execução (spec 048) — sinal de edição pós-aplicação, incluindo o
 * caso legítimo de uma normalização de fim de linha (`.gitattributes`, spec
 * 034) ter mudado os bytes sem mudar o significado.
 *
 * --trust-current-hashes: em vez de aplicar migrações pendentes, atualiza o
 * hash registrado de toda migração já rastreada para o conteúdo atual em
 * disco, e encerra. Rode uma vez para reconciliar, depois rode `bin/migrate`
 * normalmente. Nunca acontece sozinho — é preciso pedir explicitamente.
 */

require __DIR__ . '/../vendor/autoload.php';

use App\Database\MigrationRunner;
use App\Settings;
use App\Database as DB;

// Carregar variáveis de ambiente
$dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
$dotenv->load();


// Some environments (e.g. CI) set real OS environment variables instead of a
// .env file. PHP's default variables_order doesn't populate $_ENV from those,
// and phpdotenv won't override a key getenv() already reports as set — so
// bridge anything getenv() has that $_ENV doesn't.
foreach (getenv() as $key => $value) {
    if (!array_key_exists($key, $_ENV)) {
        $_ENV[$key] = $value;
    }
}

// Inicializar conexão com o banco (Eloquent)
$settings = new Settings();
DB::boot($settings);

echo "=== GastroFlow Migrations ===\n\n";

$trustCurrentHashes = in_array('--trust-current-hashes', $argv, true);

$runner = new MigrationRunner();
$runner->run($trustCurrentHashes);

echo "\n✓ Concluído.\n";
