#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * GastroFlow Migration Runner
 *
 * Uso:
 *   php bin/migrate
 *
 * Executa todos os arquivos .sql em common/sql/ que ainda
 * não foram aplicados ao banco de dados.
 */

require __DIR__ . '/../vendor/autoload.php';

use App\Database\MigrationRunner;
use App\Settings;
use App\Database as DB;

// Carregar variáveis de ambiente
$dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
$dotenv->load();


// Some environments (e.g. CI) set real OS environment variables instead of a
// .env file. PHP's default variables_order doesn't populate $_ENV from those,
// and phpdotenv won't override a key getenv() already reports as set — so
// bridge anything getenv() has that $_ENV doesn't.
foreach (getenv() as $key => $value) {
    if (!array_key_exists($key, $_ENV)) {
        $_ENV[$key] = $value;
    }
}

// Inicializar conexão com o banco (Eloquent)
$settings = new Settings();
DB::boot($settings);

echo "=== GastroFlow Migrations ===\n\n";

$runner = new MigrationRunner();
$runner->run();

echo "\n✓ Concluído.\n";
