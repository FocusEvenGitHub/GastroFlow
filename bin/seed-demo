#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * GastroFlow demo data
 *
 * Uso:
 *   php bin/seed-demo
 *
 * Preenche uma instalação nova com pedidos fictícios relativos à data de hoje: 60 pedidos
 * concluídos espalhados pelos 45 dias anteriores (horário de almoço, preparo de 8 a 25 min) e
 * 5 pendentes de hoje — o suficiente para Cozinha e Relatórios terem o que mostrar. Foi assim
 * que os prints do README foram feitos (spec 054).
 *
 * Recusa rodar se já existir qualquer pedido, a menos que APP_ENV=development: serve para banco
 * recém-instalado ou de desenvolvimento, nunca para um restaurante em uso (APP_ENV ausente conta
 * como production — Settings::getAppEnv()). Num banco que já tem pedidos, as senhas do histórico
 * continuam a partir da maior senha de cada dia. Os pedidos passam pelo OrderRepository de verdade, então
 * preço, senha e snapshot do nome saem iguais aos do caixa; só as datas são ajustadas depois.
 * Precisa do cardápio padrão (ou de itens nas categorias usadas abaixo).
 */

require __DIR__ . '/../vendor/autoload.php';

use App\Database;
use App\Models\Order;
use App\Repositories\OrderRepository;
use App\Services\PricingService;
use App\Settings;
use Illuminate\Database\Capsule\Manager as DB;

$dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
$dotenv->safeLoad();

foreach (getenv() as $key => $value) {
    if (!array_key_exists($key, $_ENV)) {
        $_ENV[$key] = $value;
    }
}

$settings = new Settings();
Database::boot($settings);

if ($settings->getAppEnv() !== 'development' && Order::query()->exists()) {
    fwrite(STDERR, "Erro: o banco \"{$_ENV['MYSQL_DATABASE']}\" já tem pedidos. bin/seed-demo só roda em instalação nova ou com APP_ENV=development.\n");
    exit(1);
}

/** Ids disponíveis de uma categoria, sem "Monte Seu Prato" nem itens de embalagem. */
$itemsOf = fn (string $category): array => DB::table('menu_items as m')
    ->join('categories as c', 'c.id', '=', 'm.category_id')
    ->where('c.name', $category)
    ->where('m.available', 1)
    ->where('m.is_customizable', 0)
    ->whereNull('m.packaging_option')
    ->pluck('m.id')
    ->all();

$mains = $itemsOf('Pratos Principais');
$drinks = $itemsOf('Bebidas');
$sides = $itemsOf('Adicionais');
$desserts = $itemsOf('Sobremesas');

if ($mains === []) {
    fwrite(STDERR, "Erro: nenhum item disponível em \"Pratos Principais\" — rode o schema padrão primeiro.\n");
    exit(1);
}

mt_srand(54);
$pick = fn (array $options): mixed => $options[mt_rand(0, count($options) - 1)];
$names = ['Ana', 'Bruno', 'Carla', 'Diego', 'Elisa', 'Fábio', 'Gabi', 'Hugo', 'Iara', 'João',
    'Lara', 'Marcos', 'Nina', 'Otávio', 'Paula', 'Rafa', 'Sofia', 'Tiago'];
$notes = ['', '', '', 'sem cebola', 'bem passado', 'molho à parte', 'sem gelo'];
$dining = ['local', 'local', 'local', 'viagem_simples', 'viagem_vip'];

$randomOrder = function () use ($pick, $mains, $drinks, $sides, $desserts, $names, $notes, $dining): array {
    $option = $pick($dining);
    $items = [['id' => $pick($mains), 'quantity' => mt_rand(1, 3) === 3 ? 2 : 1, 'notes' => $notes[mt_rand(0, count($notes) - 1)], 'dining_option' => $option]];
    foreach ([[$drinks, 60], [$sides, 35], [$desserts, 20]] as [$ids, $chance]) {
        if ($ids !== [] && mt_rand(1, 100) <= $chance) {
            $items[] = ['id' => $pick($ids), 'quantity' => 1, 'dining_option' => $option];
        }
    }
    return ['customer_name' => $names[mt_rand(0, count($names) - 1)], 'items' => $items];
};

$repo = new OrderRepository(new PricingService());
$today = strtotime('today');

// Histórico: horários sorteados e ordenados, para a senha de cada dia sair em sequência.
$history = [];
for ($i = 0; $i < 60; $i++) {
    $history[] = $today - mt_rand(1, 45) * 86400 + mt_rand(11 * 3600, 15 * 3600 - 1);
}
sort($history);

DB::transaction(function () use ($history, $repo, $randomOrder) {
    $lastNumber = [];
    foreach ($history as $i => $createdAt) {
        $day = date('Y-m-d', $createdAt);
        $lastNumber[$day] ??= (int) DB::table('orders')->where('business_date', $day)
            ->selectRaw('MAX(CAST(order_number AS UNSIGNED)) AS n')->value('n');
        $lastNumber[$day]++;

        // createOrder() sempre grava business_date = hoje: a senha provisória não colide com as
        // de hoje (índice único por dia) e não faz o contador de hoje andar; a definitiva entra
        // junto com a data do passado.
        $order = $repo->createOrder($randomOrder() + ['order_number' => "seed-{$i}"]);
        DB::table('orders')->where('id', $order->id)->update([
            'order_number'  => (string) $lastNumber[$day],
            'status'        => Order::STATUS_DONE,
            'business_date' => $day,
            'created_at'    => date('Y-m-d H:i:s', $createdAt),
            'updated_at'    => date('Y-m-d H:i:s', $createdAt + mt_rand(8, 25) * 60),
        ]);
    }

    // Pendentes de hoje: senha automática (as próximas do dia — 1..5 num banco novo), abertos há 3 a 15 minutos.
    for ($i = 5; $i >= 1; $i--) {
        $order = $repo->createOrder($randomOrder());
        DB::table('orders')->where('id', $order->id)->update([
            'created_at' => date('Y-m-d H:i:s', time() - $i * 180),
        ]);
    }
});

fwrite(STDOUT, "✓ " . count($history) . " pedidos concluídos (últimos 45 dias) e 5 pendentes de hoje criados em \"{$_ENV['MYSQL_DATABASE']}\".\n");
