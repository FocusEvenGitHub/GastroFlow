#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * GastroFlow Realtime Events Prune
 *
 * Remove eventos mais antigos que N dias. Estes registros existem para a cozinha recuperar
 * o que perdeu ao reconectar (Last-Event-ID) — não são histórico de pedidos.
 *
 * Uso:
 *   php bin/events-prune [--days=N]
 *
 * Sem --days, usa EVENTS_RETENTION_DAYS (padrão: 2).
 */

require __DIR__ . '/../vendor/autoload.php';

use App\Services\DatabaseEventPublisher;
use App\Settings;
use App\Database as DB;

$dotenv = Dotenv\Dotenv::createImmutable(__DIR__ . '/..');
$dotenv->load();

$settings = new Settings();
DB::boot($settings);

$days = null;
for ($i = 1; $i < $argc; $i++) {
    if (str_starts_with($argv[$i], '--days=')) {
        $days = (int) substr($argv[$i], 7);
        if ($days < 1) {
            fwrite(STDERR, "--days deve ser um inteiro maior que zero.\n");
            exit(1);
        }
    }
}

$effectiveDays = $days ?? $settings->getEventsRetentionDays();

$publisher = new DatabaseEventPublisher();
$pruned = $publisher->pruneOlderThan($effectiveDays);

echo "=== GastroFlow — Limpeza de eventos ===\n";
echo "Retenção: {$effectiveDays} dia(s)\n";
echo "Eventos removidos: {$pruned}\n";

exit(0);
