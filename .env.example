# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# ------------------------------------------------------------------
# Database (used by docker-compose.yml's `db` service and by the app)
# ------------------------------------------------------------------
DB_HOST=db
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=restaurant
MYSQL_USER=restuser
MYSQL_PASSWORD=changeme

# ------------------------------------------------------------------
# Authentication / CORS
# ------------------------------------------------------------------
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional. Restricts which origin can call the API; defaults to "*" (any
# origin) when unset. Set to your actual frontend origin in production.
CORS_ALLOWED_ORIGIN=*

# ------------------------------------------------------------------
# Application environment
# ------------------------------------------------------------------
# One of: development, test, production. Defaults to "production" when
# unset - set this explicitly for local development.
APP_ENV=development

# true/false. Defaults to false (safe) when unset.
APP_DEBUG=true

# Optional IANA timezone name (e.g. America/Sao_Paulo, UTC). Defaults to
# the container's configured timezone when unset.
APP_TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------
# Job queue (bin/worker)
# ------------------------------------------------------------------
# Optional. Seconds a worker may hold a job reservation before the job is
# treated as abandoned and becomes claimable again - this is what recovers
# a job whose worker died mid-execution. Defaults to 300 when unset.
QUEUE_RESERVATION_TIMEOUT=300

# Optional. Days a completed job is kept before being pruned by the worker
# or by bin/jobs-prune. Failed jobs are never pruned automatically - they
# are the diagnostic record. Defaults to 7 when unset.
QUEUE_RETENTION_DAYS=7

# Optional. Days a realtime kitchen event is kept before being pruned by the
# worker or by bin/events-prune. These rows exist so a reconnecting client
# can catch up (Last-Event-ID), not as an audit trail, so the window is
# short. Defaults to 2 when unset.
EVENTS_RETENTION_DAYS=2

# ------------------------------------------------------------------
# Integration tests (spec 035)
# ------------------------------------------------------------------
# Optional, and deliberately unset by default. The integration suite writes
# real rows, so it needs its own database and refuses to touch this one:
# unset -> the integration tests skip themselves; set to the SAME value as
# MYSQL_DATABASE -> the suite fails rather than risk your data.
# Create it once: CREATE DATABASE restaurant_test; plus a GRANT for MYSQL_USER.
# MYSQL_DATABASE_TEST=restaurant_test
