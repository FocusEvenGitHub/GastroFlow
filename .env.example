# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# ------------------------------------------------------------------
# Database (used by docker-compose.yml's `db` service and by the app)
# ------------------------------------------------------------------
DB_HOST=db
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=restaurant
MYSQL_USER=restuser
MYSQL_PASSWORD=changeme

# ------------------------------------------------------------------
# Authentication / CORS
# ------------------------------------------------------------------
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional. Restricts which origin can call the API; defaults to "*" (any
# origin) when unset. Set to your actual frontend origin in production.
CORS_ALLOWED_ORIGIN=*

# ------------------------------------------------------------------
# Application environment
# ------------------------------------------------------------------
# One of: development, test, production. Defaults to "production" when
# unset - set this explicitly for local development.
APP_ENV=development

# true/false. Defaults to false (safe) when unset.
APP_DEBUG=true

# Optional IANA timezone name (e.g. America/Sao_Paulo, UTC). Defaults to
# the container's configured timezone when unset.
APP_TIMEZONE=America/Sao_Paulo
